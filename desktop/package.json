{
  "name": "lemmalab-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LemmaLab desktop app (Electron + React + TypeScript)",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:colors": "node scripts/lint-colors.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshots.ts",
    "screenshots:dev": "node scripts/screenshots.ts --dev",
    "phase1": "node scripts/phase1.ts",
    "phase1:dev": "node scripts/phase1.ts --dev",
    "phase2": "node scripts/phase2.ts",
    "phase2:dev": "node scripts/phase2.ts --dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^12.0.0",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.14.6",
    "tailwind-merge": "^3.7.0",
    "three": "~0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "~0.184.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
