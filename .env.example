# Copy to .env (make does this on first run). Never commit .env.

APP_ENV=local

# Used from the host (e.g. running alembic or pytest outside Docker).
# Inside docker-compose, DATABASE_URL is rebuilt from the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://lemma:change-me@localhost:5433/lemma

POSTGRES_USER=lemma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lemma

# none | <provider>  (see backend/app/llm/llm_client.py)
LLM_PROVIDER=none
LLM_API_KEY=
